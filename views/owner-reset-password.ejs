<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Reset Password</title>
    <%- include('./partials/theme-head') %>
</head>

<body class="flex flex-col min-h-screen">
    <%- include('./partials/header') %>

    <% if(error && error.length > 0){ %>
        <div class="fixed left-1/2 top-24 z-50 -translate-x-1/2 rounded border border-red-200 bg-red-50 px-6 py-3 text-sm font-semibold text-red-600 shadow-lg">
            <%= error %>
        </div>
    <% } %>

    <main class="flex-grow flex items-center justify-center pt-10 pb-20">
        <div class="max-w-7xl mx-auto w-full flex flex-col lg:flex-row items-center gap-10 lg:gap-20">
            
            <!-- Left Side Image -->
            <div class="hidden lg:flex w-full lg:w-1/2 bg-[#CBE4E8] rounded-r rounded-l-none h-[600px] items-center justify-center relative overflow-hidden">
                <img src="https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?q=80&w=1000&auto=format&fit=crop" class="w-full h-full object-cover mix-blend-multiply opacity-80" alt="Admin access">
            </div>

            <!-- Right Side Form -->
            <div class="w-full lg:w-1/2 px-4 sm:px-10 lg:px-0 max-w-md">
                <h2 class="text-3xl font-medium text-black mb-2 tracking-wide">Admin Reset Password</h2>
                <p class="text-sm text-black mb-8">Enter your new admin password below</p>

                <form autocomplete="off" action="/owners/reset-password/<%= token %>" method="post" class="space-y-6">
                    <div>
                        <input id="reset-password" class="hk-input" type="password" placeholder="New Admin Password" name="password" required minlength="6">
                    </div>
                    <div>
                        <input id="confirm-password" class="hk-input" type="password" placeholder="Confirm Admin Password" name="confirmPassword" required minlength="6">
                    </div>
                    <button class="hk-btn w-full mt-8" type="submit">
                        Reset Admin Password
                    </button>
                </form>
            </div>
        </div>
    </main>

    <%- include('./partials/footer') %>
</body>

</html>
